{
  "name": "codeguard-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.1.43",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "jsdom": "26.1.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
